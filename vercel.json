{
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "onebus.us-east-2.elasticbeanstalk.com/api/$1",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "*",
        "Access-Control-Allow-Headers": "*"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}